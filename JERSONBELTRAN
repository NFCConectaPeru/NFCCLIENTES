<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">  
    <title>Jerson Beltrán - Digital Card</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
            font-family: 'Segoe UI', Roboto, sans-serif; 
        }

        body {
            background-color: #0d2820;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 15px;
        }

        .digital-card {
            background: #11382d;
            border: 1px solid #c09728;
            width: 100%;
            max-width: 390px;
            border-radius: 28px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            color: #ffffff;
        }

        /* Estilo para el logo propio */
        .brand-logo-container {
            margin-bottom: 5px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .brand-logo {
            max-width: 140px;      /* Ancho máximo recomendado */
            max-height: 60px;      /* Alto máximo recomendado */
            object-fit: contain;   /* Mantiene las proporciones del logo sin estirarlo */
            display: block;
        }

        .brand-sub {
            font-size: 9px;
            letter-spacing: 3px;
            color: #a3b8b0;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 2px solid #d4af37;
            padding: 4px;
            margin: 0 auto 15px;
        }

        .avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .name {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .title {
            color: #d4af37;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 25px;
        }

        .grid-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-item {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 14px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            color: #ffffff;
            text-decoration: none;
            font-size: 14px;
            transition: 0.3s;
        }

        .btn-item:hover {
            background: rgba(212, 175, 55, 0.2);
            border-color: #d4af37;
        }

        .btn-item i {
            font-size: 20px;
            margin-right: 15px;
            width: 25px;
            color: #d4af37;
        }

        .btn-primary-action {
            background: #d4af37;
            color: #0d2820;
            font-weight: 700;
            justify-content: center;
            margin-bottom: 15px;
        }

        .btn-primary-action i {
            color: #0d2820;
        }
    </style>
</head>
<body>

    <div class="digital-card">
        <!-- Reemplaza el src con el enlace directo de tu propio logo -->
        <div class="brand-logo-container">
            <img src="https://i.postimg.cc/3JtVXpMd/Logo-Original-lien.png" alt="Logo de la Empresa" class="brand-logo">
        </div>
        <div class="brand-sub">boutique inmobiliaria</div>

        <div class="avatar">
            <img src="https://i.postimg.cc/vZVDhbQp/Screenshot-2026-08-31-22-24-29-606-com-instagold-android.png" alt="Jerson Beltrán">
        </div>

        <h1 class="name">Jerson Beltrán</h1>
        <p class="title">Asociado Inmobiliario</p>

        <div class="grid-links">
            <a href="tel:+51959170612" class="btn-item btn-primary-action">
                <i class="fa-solid fa-address-card"></i> Guardar en Agenda
            </a>

            <a href="https://wa.me/51959170612" class="btn-item" target="_blank">
                <i class="fa-brands fa-whatsapp"></i> WhatsApp
            </a>

            <a href="mailto:jerson.beltran@lien.pe" class="btn-item" target="_blank">
                <i class="fa-solid fa-envelope"></i> Correo Electrónico
            </a>

            <a href="https://www.lien.pe" class="btn-item" target="_blank">
                <i class="fa-solid fa-globe"></i> Página Web
            </a>

            <a href="https://instagram.com/jersonbeltransmischek" class="btn-item" target="_blank">
                <i class="fa-brands fa-instagram"></i> Instagram
            </a>

            <a href="https://tiktok.com/@jersonbeltransmischek" class="btn-item" target="_blank">
                <i class="fa-brands fa-tiktok"></i> TikTok
            </a>
        </div>
    </div>

</body>
</html>
